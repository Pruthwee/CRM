# CRM Application Environment Variables Template
# Copy this file to .env and update with your actual values

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# MySQL database connection settings
# For AWS: Use RDS endpoint
# For Azure: Use Azure Database for MySQL endpoint
# For GCP: Use Cloud SQL endpoint

DATABASE_URL=jdbc:mysql://localhost:3306/crm?useSSL=false
DATABASE_USERNAME=root
DATABASE_PASSWORD=password

# ============================================================================
# REDIS SESSION STORE CONFIGURATION
# ============================================================================
# Redis connection settings for distributed session management
# For AWS: Use ElastiCache for Redis endpoint
# For Azure: Use Azure Cache for Redis endpoint
# For GCP: Use Cloud Memorystore for Redis endpoint

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Redis connection pool settings (optional - defaults are provided)
# REDIS_TIMEOUT=2000ms

# ============================================================================
# SESSION CONFIGURATION
# ============================================================================
# Session timeout in seconds (default: 1800 = 30 minutes)
SESSION_TIMEOUT=1800s

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
# Server port (default: 8080)
SERVER_PORT=8080

# Spring profile (development, staging, production)
SPRING_PROFILES_ACTIVE=development

# ============================================================================
# AWS SPECIFIC CONFIGURATION (if deploying to AWS)
# ============================================================================
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# ElastiCache Redis endpoint example:
# REDIS_HOST=your-cluster.cache.amazonaws.com
# REDIS_PORT=6379

# RDS MySQL endpoint example:
# DATABASE_URL=jdbc:mysql://your-instance.rds.amazonaws.com:3306/crm?useSSL=true

# ============================================================================
# AZURE SPECIFIC CONFIGURATION (if deploying to Azure)
# ============================================================================
# Azure Cache for Redis example:
# REDIS_HOST=your-cache.redis.cache.windows.net
# REDIS_PORT=6380
# REDIS_PASSWORD=your-access-key

# Azure Database for MySQL example:
# DATABASE_URL=jdbc:mysql://your-server.mysql.database.azure.com:3306/crm?useSSL=true
# DATABASE_USERNAME=admin@your-server

# ============================================================================
# GCP SPECIFIC CONFIGURATION (if deploying to GCP)
# ============================================================================
# Cloud Memorystore for Redis example:
# REDIS_HOST=10.0.0.3
# REDIS_PORT=6379

# Cloud SQL for MySQL example:
# DATABASE_URL=jdbc:mysql://your-instance-ip:3306/crm?useSSL=true

# ============================================================================
# MONITORING AND LOGGING (optional)
# ============================================================================
# LOGGING_LEVEL_ROOT=INFO
# LOGGING_LEVEL_CRM=DEBUG

# ============================================================================
# SECURITY (optional)
# ============================================================================
# Enable HTTPS in production
# SERVER_SSL_ENABLED=true
# SERVER_SSL_KEY_STORE=classpath:keystore.p12
# SERVER_SSL_KEY_STORE_PASSWORD=your-keystore-password
# SERVER_SSL_KEY_STORE_TYPE=PKCS12

# ============================================================================
# NOTES
# ============================================================================
# 1. Never commit .env file to version control
# 2. Use AWS Secrets Manager, Azure Key Vault, or GCP Secret Manager in production
# 3. Ensure Redis is accessible from your application instances
# 4. Use SSL/TLS for database and Redis connections in production
# 5. Configure VPC/network security groups appropriately
