# Environment Variables Template for CRM Application
# Copy this file to .env and update with your actual values

# ============================================
# Database Configuration
# ============================================
DATABASE_URL=jdbc:mysql://localhost:3306/crm?useSSL=false
DATABASE_USERNAME=root
DATABASE_PASSWORD=password
DB_DDL_AUTO=update

# ============================================
# Database Connection Pool Settings
# ============================================
DB_POOL_SIZE=10
DB_POOL_MIN_IDLE=2
DB_CONNECTION_TIMEOUT=30000
DB_IDLE_TIMEOUT=600000
DB_MAX_LIFETIME=1800000

# ============================================
# Azure Blob Storage Configuration
# ============================================
AZURE_STORAGE_ENABLED=false
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your-account;AccountKey=your-key;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=crm-files

# ============================================
# Timezone Configuration
# ============================================
APP_TIMEZONE=UTC
DISPLAY_TIMEZONE=UTC

# ============================================
# Server Configuration
# ============================================
SERVER_PORT=8080

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=INFO
APP_LOG_LEVEL=DEBUG

# ============================================
# Thymeleaf Configuration
# ============================================
THYMELEAF_CACHE=false

# ============================================
# Spring Profile
# ============================================
SPRING_PROFILES_ACTIVE=default
# Use 'azure' for Azure cloud deployment
# SPRING_PROFILES_ACTIVE=azure
