# Environment Variables Template for CRM Application
# Copy this file to .env and fill in your values
# DO NOT commit .env file to version control

# ============================================
# Database Configuration
# ============================================
# Cloud SQL connection string
DATABASE_URL=jdbc:mysql://CLOUD_SQL_IP:3306/crm?useSSL=false
# For Cloud SQL Proxy: jdbc:mysql:///crm?cloudSqlInstance=PROJECT_ID:REGION:INSTANCE_NAME&socketFactory=com.google.cloud.sql.mysql.SocketFactory

# Database credentials
DB_USERNAME=root
DB_PASSWORD=your-secure-password

# Database connection pool settings
DB_POOL_SIZE=10
DB_MIN_IDLE=5
DB_CONN_TIMEOUT=30000
DB_IDLE_TIMEOUT=600000
DB_MAX_LIFETIME=1800000

# Database DDL mode (create-drop, update, validate, none)
DB_DDL_AUTO=update

# ============================================
# Google Cloud Platform Configuration
# ============================================
# GCP Project ID
GCP_PROJECT_ID=your-gcp-project-id

# Google Cloud Storage bucket name
GCS_BUCKET_NAME=your-gcs-bucket-name

# GCS folder paths
GCS_PDF_FOLDER=pdfs
GCS_CSV_FOLDER=csv

# GCP credentials location (optional - uses ADC if not set)
# GCP_CREDENTIALS_LOCATION=/path/to/service-account-key.json

# ============================================
# Application Configuration
# ============================================
# Server port
PORT=8080

# Thymeleaf cache (false for development, true for production)
THYMELEAF_CACHE=false

# ============================================
# Logging Configuration
# ============================================
# Root log level (TRACE, DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO

# Application log level
APP_LOG_LEVEL=DEBUG

# ============================================
# Cloud-Specific Settings
# ============================================
# Spring profiles (dev, prod, cloud)
SPRING_PROFILES_ACTIVE=cloud

# ============================================
# Development/Testing Only
# ============================================
# CSV blob name for testing
CSV_BLOB_NAME=test-data.csv

# ============================================
# Production Settings
# ============================================
# Enable production optimizations
# SPRING_JPA_SHOW_SQL=false
# SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=false
# THYMELEAF_CACHE=true
# LOG_LEVEL=WARN
# APP_LOG_LEVEL=INFO
