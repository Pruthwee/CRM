# Environment Variables Template for CRM Application
# Copy this file to .env and fill in your values
# DO NOT commit .env file to version control

# Spring Profile
SPRING_PROFILES_ACTIVE=gcp

# Database Configuration
DATABASE_URL=jdbc:mysql://localhost:3306/crm?useSSL=false
DATABASE_USERNAME=root
DATABASE_PASSWORD=your-secure-password
DB_DDL_AUTO=update

# Database Connection Pool
DB_POOL_SIZE=10
DB_POOL_MIN_IDLE=2
DB_CONNECTION_TIMEOUT=30000
DB_IDLE_TIMEOUT=600000
DB_MAX_LIFETIME=1800000

# GCP Cloud Storage
GCP_STORAGE_BUCKET=crm-files-bucket
GCP_PROJECT_ID=your-gcp-project-id
GCP_CREDENTIALS_PATH=/path/to/credentials.json

# Application Configuration
PORT=8080
THYMELEAF_CACHE=false

# Timezone Configuration
APP_DISPLAY_TIMEZONE=UTC

# Temporary Directory
TEMP_DIR=/tmp

# Cloud SQL Configuration (for GCP Cloud SQL)
# CLOUD_SQL_INSTANCE=project:region:instance
# DB_NAME=crm
