# Azure CRM Application - Environment Variables Template
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to source control

# ============================================================================
# AZURE BLOB STORAGE CONFIGURATION
# ============================================================================
# Azure Storage Account Connection String (REQUIRED)
# Get this from Azure Portal > Storage Account > Access Keys
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=YOUR_ACCOUNT_NAME;AccountKey=YOUR_ACCOUNT_KEY;EndpointSuffix=core.windows.net

# Azure Storage Container Name (Optional, defaults to 'crm-files')
AZURE_STORAGE_CONTAINER_NAME=crm-files

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# Database URL - Azure Database for MySQL or local MySQL
# Azure: jdbc:mysql://YOUR_SERVER.mysql.database.azure.com:3306/crm?useSSL=true&requireSSL=true
# Local: jdbc:mysql://localhost:3306/crm?useSSL=false
DATABASE_URL=jdbc:mysql://localhost:3306/crm?useSSL=false

# Database Username
# Azure format: username@servername
# Local format: username
DATABASE_USERNAME=root

# Database Password
DATABASE_PASSWORD=password

# Database DDL Mode (create-drop, update, validate, none)
# Use 'update' for production, 'create-drop' for development
DB_DDL_AUTO=update

# ============================================================================
# DATABASE CONNECTION POOL CONFIGURATION
# ============================================================================
# Maximum number of connections in the pool
DB_POOL_SIZE=10

# Minimum number of idle connections
DB_POOL_MIN_IDLE=2

# Connection timeout in milliseconds (30 seconds)
DB_CONNECTION_TIMEOUT=30000

# Idle timeout in milliseconds (10 minutes)
DB_IDLE_TIMEOUT=600000

# Maximum lifetime of a connection in milliseconds (30 minutes)
DB_MAX_LIFETIME=1800000

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
# Application Timezone (UTC recommended for cloud deployments)
APP_TIMEZONE=UTC

# Server Port
PORT=8080

# Thymeleaf Template Caching (false for development, true for production)
THYMELEAF_CACHE=false

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
# Root Log Level (ERROR, WARN, INFO, DEBUG, TRACE)
LOG_LEVEL=INFO

# Application Log Level
APP_LOG_LEVEL=DEBUG

# Azure SDK Log Level
AZURE_LOG_LEVEL=INFO

# ============================================================================
# AZURE SPECIFIC CONFIGURATION (Optional)
# ============================================================================
# Azure Application Insights Connection String (for monitoring)
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=YOUR_KEY;IngestionEndpoint=https://YOUR_REGION.in.applicationinsights.azure.com/

# Azure Key Vault URL (for secrets management)
# AZURE_KEYVAULT_URL=https://YOUR_KEYVAULT.vault.azure.net/

# ============================================================================
# DEVELOPMENT/TESTING CONFIGURATION
# ============================================================================
# For local development with Azurite (Azure Storage Emulator)
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;

# ============================================================================
# NOTES
# ============================================================================
# 1. Never commit this file with actual values to source control
# 2. Use Azure Key Vault for production secrets
# 3. Use managed identities when deploying to Azure
# 4. Rotate credentials regularly
# 5. Use different values for different environments (dev, staging, prod)
