# CRM Application - Environment Variables Template
# Copy this file to .env and fill in your values
# DO NOT commit .env file to version control

# ============================================
# Google Cloud Platform Configuration
# ============================================

# GCP Project ID (required for GCS and other GCP services)
GCP_PROJECT_ID=your-project-id

# Google Cloud Storage bucket name for file storage
GCS_BUCKET_NAME=crm-storage-bucket

# GCS folder paths (optional, defaults provided)
GCS_PDF_FOLDER=pdfs
GCS_CSV_FOLDER=csv-files

# ============================================
# Database Configuration
# ============================================

# Database connection URL
# For Cloud SQL: jdbc:mysql://google/crm?cloudSqlInstance=PROJECT:REGION:INSTANCE&socketFactory=com.google.cloud.sql.mysql.SocketFactory
# For local MySQL: jdbc:mysql://localhost:3306/crm?useSSL=false
DATABASE_URL=jdbc:mysql://localhost:3306/crm?useSSL=false

# Database credentials
DB_USERNAME=root
DB_PASSWORD=password

# Database connection pool settings
DB_POOL_SIZE=10
DB_POOL_MIN_IDLE=2
DB_CONNECTION_TIMEOUT=30000
DB_IDLE_TIMEOUT=600000
DB_MAX_LIFETIME=1800000

# Hibernate DDL auto mode (create-drop, update, validate, none)
DB_DDL_AUTO=update

# ============================================
# Application Configuration
# ============================================

# Server port (Cloud Run and GKE will override this)
PORT=8080

# Logging levels
LOG_LEVEL=INFO
APP_LOG_LEVEL=DEBUG

# Thymeleaf cache (set to true in production)
THYMELEAF_CACHE=false

# ============================================
# Security Configuration (if needed)
# ============================================

# JWT secret key (if implementing JWT authentication)
# JWT_SECRET=your-secret-key-here

# Session timeout in seconds
# SESSION_TIMEOUT=3600

# ============================================
# Cloud-Specific Settings
# ============================================

# Enable/disable cloud features
CLOUD_ENABLED=true

# GCS connection timeout (milliseconds)
GCS_TIMEOUT=30000

# ============================================
# Development/Testing Settings
# ============================================

# Use local filesystem instead of GCS (for development only)
USE_LOCAL_STORAGE=false

# Local storage path (if USE_LOCAL_STORAGE=true)
LOCAL_STORAGE_PATH=/tmp/crm-storage

# ============================================
# Monitoring and Observability
# ============================================

# Enable detailed metrics
METRICS_ENABLED=true

# Enable distributed tracing
TRACING_ENABLED=false

# Trace sampling rate (0.0 to 1.0)
TRACE_SAMPLING_RATE=0.1

# ============================================
# Notes
# ============================================
# 
# For GKE deployment:
# - Create ConfigMap: kubectl create configmap crm-config --from-env-file=.env
# - Create Secret: kubectl create secret generic crm-secrets --from-env-file=.env
#
# For Cloud Run deployment:
# - Use --set-env-vars flag or Secret Manager
#
# For App Engine deployment:
# - Add to app.yaml env_variables section
#
# For local development:
# - Use this file with docker-compose or export variables
# - Authenticate with: gcloud auth application-default login
