# Environment Variables Template for GCP Deployment
# Copy this file to .env and fill in the values
# DO NOT commit .env file to version control

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# Cloud SQL connection string or external database URL
DATABASE_URL=jdbc:mysql://localhost:3306/crm?useSSL=false

# Database credentials (use Secret Manager in production)
DATABASE_USERNAME=root
DATABASE_PASSWORD=password

# HikariCP Connection Pool Settings
DB_POOL_SIZE=10
DB_MIN_IDLE=2
DB_CONNECTION_TIMEOUT=30000
DB_IDLE_TIMEOUT=600000
DB_MAX_LIFETIME=1800000

# Database DDL mode (update, create, create-drop, validate, none)
DB_DDL_AUTO=update

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
# Server port (Cloud Run uses PORT environment variable)
PORT=8080

# ============================================================================
# GOOGLE CLOUD PLATFORM CONFIGURATION
# ============================================================================
# GCP Project ID
GCP_PROJECT_ID=your-gcp-project-id

# Google Cloud Storage bucket name for file storage
GCS_BUCKET_NAME=your-gcs-bucket-name

# Optional prefix for file paths in GCS bucket
FILE_PATH_PREFIX=uploads

# CSV file path in GCS bucket
CSV_FILE_PATH=data/sample.csv

# Default filename for legacy file operations
DEFAULT_FILE_NAME=default-file.csv

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
# Root logging level (TRACE, DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO

# Application-specific logging level
APP_LOG_LEVEL=INFO

# ============================================================================
# THYMELEAF CONFIGURATION
# ============================================================================
# Enable/disable Thymeleaf template caching
THYMELEAF_CACHE=false

# ============================================================================
# NOTES
# ============================================================================
# 1. For production deployments, use Google Cloud Secret Manager for sensitive values
# 2. Ensure service account has required IAM permissions:
#    - roles/storage.objectViewer (GCS read)
#    - roles/datastore.user (Firestore read/write)
#    - roles/cloudsql.client (Cloud SQL connection)
#    - roles/secretmanager.secretAccessor (Secret Manager access)
# 3. All timestamps use UTC timezone for consistency
# 4. Local file operations use ephemeral storage (automatically cleaned up)
