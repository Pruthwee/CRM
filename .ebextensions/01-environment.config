# AWS Elastic Beanstalk Configuration
# Place this file in .ebextensions/01-environment.config

option_settings:
  # Application Environment Variables
  aws:elasticbeanstalk:application:environment:
    # Database Configuration (use RDS endpoint)
    DB_URL: "jdbc:mysql://${RDS_HOSTNAME}:${RDS_PORT}/${RDS_DB_NAME}?useSSL=true&requireSSL=true"
    DB_USERNAME: "${RDS_USERNAME}"
    DB_PASSWORD: "${RDS_PASSWORD}"
    DB_DDL_AUTO: "validate"
    DB_POOL_SIZE: "20"
    DB_POOL_MIN_IDLE: "10"
    DB_CONNECTION_TIMEOUT: "30000"
    
    # Redis Configuration (use ElastiCache endpoint)
    REDIS_HOST: "${ELASTICACHE_ENDPOINT}"
    REDIS_PORT: "6379"
    SESSION_STORE_TYPE: "redis"
    REDIS_POOL_MAX_ACTIVE: "16"
    
    # Application Configuration
    SESSION_TIMEOUT: "1800"
    LOG_LEVEL: "INFO"
    THYMELEAF_CACHE: "true"
    SPRING_PROFILES_ACTIVE: "cloud"
    
  # Java Platform Configuration
  aws:elasticbeanstalk:container:java:
    JVMOptions: "-Xmx512m -Xms256m -XX:+UseG1GC"
    
  # Load Balancer Configuration
  aws:elasticbeanstalk:environment:
    LoadBalancerType: application
    ServiceRole: aws-elasticbeanstalk-service-role
    
  # Auto Scaling Configuration
  aws:autoscaling:asg:
    MinSize: 2
    MaxSize: 10
    
  aws:autoscaling:trigger:
    MeasureName: CPUUtilization
    Statistic: Average
    Unit: Percent
    UpperThreshold: 70
    LowerThreshold: 30
    
  # Health Check Configuration
  aws:elasticbeanstalk:application:
    Application Healthcheck URL: /appinfo/health
    
  # CloudWatch Logs
  aws:elasticbeanstalk:cloudwatch:logs:
    StreamLogs: true
    DeleteOnTerminate: false
    RetentionInDays: 7

# Commands to run before deployment
commands:
  01_install_wget:
    command: "yum install -y wget"
    
# Files to create
files:
  "/etc/cron.d/session_cleanup":
    mode: "000644"
    owner: root
    group: root
    content: |
      # Clean up expired sessions from Redis every hour
      0 * * * * root redis-cli -h ${ELASTICACHE_ENDPOINT} --scan --pattern "spring:session:*" | xargs redis-cli -h ${ELASTICACHE_ENDPOINT} del
